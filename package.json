{
  "name": "homepage",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "pnpm content && concurrently -n velite,next -c blue,green \"velite dev\" \"next dev\"",
    "build": "pnpm content && next build",
    "preview": "wrangler dev --port 3000",
    "content": "velite build && node scripts/build-images.ts",
    "typecheck": "pnpm content && tsc --noEmit",
    "check:ui": "node scripts/check-ui-contracts.ts",
    "check:static": "node scripts/check-static-export.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "shoot": "node scripts/shoot.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.18.0",
    "motion": "12.40.0",
    "next": "16.2.9",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.9.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "10.0.3",
    "playwright": "^1.60.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-pretty-code": "0.14.3",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.5",
    "shiki": "4.2.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "velite": "0.3.1",
    "wrangler": "^4.151.0"
  }
}
